# Pyrogram API credentials — get from https://my.telegram.org
API_KEY=12345
API_HASH=abcd1234

# Bot token from @BotFather
BOT_TOKEN=123:ABC

# Telegram user ID allowed to run /stats. ADMIN_ID takes priority;
# OWNER_ID is used as a fallback if ADMIN_ID is unset.
ADMIN_ID=
OWNER_ID=

# Optional
WORKERS=4
CHANNEL_URL=
BOT_URL=tiktokbot

# Optional: base64-encoded cookies.txt, restored on startup by start.sh
# if cookies.txt doesn't already exist. Not needed if you keep cookies.txt
# on the server directly (recommended — see README).
COOKIES_B64=
