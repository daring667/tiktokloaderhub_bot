[Unit]
Description=Telegram Video Downloader Bot (TikTok/YouTube)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User={{RUN_USER}}
WorkingDirectory={{PROJECT_DIR}}
ExecStart={{PROJECT_DIR}}/venv/bin/python main.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tiktokbot

# Keep the bot (and the ffmpeg/yt-dlp children in its cgroup) from being able
# to starve the rest of the box — this machine has already seen OOM kills.
# MemoryHigh throttles first; MemoryMax is the hard ceiling.
MemoryHigh=600M
MemoryMax=800M

[Install]
WantedBy=multi-user.target
