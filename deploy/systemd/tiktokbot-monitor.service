[Unit]
Description=TikTok Bot Healthcheck Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/tiktokbot-monitor.env
ExecStart=/usr/local/bin/tiktokbot_monitor.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tiktokbot-monitor

# The monitor restarts the bot through systemctl and therefore needs root
# privileges. Keep the environment file root-owned and mode 600.

# Timeouts
TimeoutStartSec=300
TimeoutStopSec=30
