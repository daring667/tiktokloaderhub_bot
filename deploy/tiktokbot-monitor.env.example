# Example configuration for tiktokbot-monitor
# Copy to /etc/tiktokbot-monitor.env and fill in your actual values.
# deploy/setup_monitoring.sh does this for you and fills in PYTHON_PATH/PROJECT_DIR.

# Telegram Bot Token (from @BotFather)
# This token is used by the monitor to send notifications
# DO NOT commit this file to version control with actual token!
NOTIFY_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Telegram Chat ID where notifications will be sent (your personal Telegram ID)
NOTIFY_CHAT_ID=YOUR_CHAT_ID_HERE

# A stable, consistently downloadable video URL.
# The monitor tries to download this every 5 minutes as a healthcheck.
# Pick something durable (a large verified account's video) — old/niche
# videos can go stale on the CDN and cause false-positive restarts.
HEALTHCHECK_TEST_URL=https://www.tiktok.com/@tiktok/video/

# Name of the systemd service to monitor
SERVICE_NAME=tiktokbot.service

# Full path to the Python interpreter in your venv
PYTHON_PATH=/home/youruser/TiktokBot/TT/venv/bin/python

# Project directory (where main.py and healthcheck.py are located)
PROJECT_DIR=/home/youruser/TiktokBot/TT

# Timeout for healthcheck download in seconds
# If download takes longer, it's considered a failure
HEALTHCHECK_TIMEOUT=180

# Number of log lines to include in Telegram notifications
LOG_TAIL_LINES=50

# How far back to look in journalctl for logs
# Format: "10m", "1h", "2h", etc.
LOG_LOOK_BACK=10m
